		"@node-rs/argon2": "^1.8.3",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@vercel/blob": "^0.27.3",
		"drizzle-orm": "^0.38.4"
	}
